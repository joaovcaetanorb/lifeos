# Copie este arquivo para ".env" (na mesma pasta) e preencha com os valores
# reais — os mesmos já configurados hoje no secrets.toml do Streamlit Cloud
# (dashboard do app -> Settings -> Secrets). Este arquivo (.env) é
# gitignored: nunca commitar credencial de verdade.

# Banco Turso do módulo música (mesmo banco que o Streamlit usa em produção)
TURSO_MUSICA_URL=
TURSO_MUSICA_TOKEN=

# Banco Turso do módulo livros
TURSO_LIVROS_URL=
TURSO_LIVROS_TOKEN=

# Banco Turso do módulo hábitos
TURSO_HABITOS_URL=
TURSO_HABITOS_TOKEN=

# Banco Turso do módulo humor
TURSO_HUMOR_URL=
TURSO_HUMOR_TOKEN=

# Banco Turso do módulo projetos
TURSO_PROJETOS_URL=
TURSO_PROJETOS_TOKEN=

# Banco Turso do módulo financeiro (banco NOVO — não é o mesmo do financeiro
# no Streamlit; ver webapp/financeiro/db.py)
TURSO_FINANCEIRO_URL=
TURSO_FINANCEIRO_TOKEN=

# Banco Turso do módulo momentos (banco NOVO — sem equivalente no Streamlit)
TURSO_MOMENTOS_URL=
TURSO_MOMENTOS_TOKEN=

# Banco Turso do módulo Beat Forge (banco NOVO — sem equivalente no Streamlit)
TURSO_BEATFORGE_URL=
TURSO_BEATFORGE_TOKEN=

# Banco Turso do módulo revisão (banco NOVO — sem equivalente no Streamlit)
TURSO_REVISAO_URL=
TURSO_REVISAO_TOKEN=

# Credenciais do app Spotify (developer.spotify.com/dashboard)
# SPOTIFY_REDIRECT_URI para uso local precisa estar cadastrado como Redirect
# URI adicional no dashboard do app Spotify — ver webapp/README.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/musica/spotify/callback

# Groq (insights de IA)
GROQ_API_KEY=
